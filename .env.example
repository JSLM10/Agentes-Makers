# FluentDrop — variables de entorno
# Copiar a `.env` para correr en local. En Vercel se cargan en
# Settings > Environment Variables del proyecto.

# Clave del endpoint OpenAI-compatible de NVIDIA NIM.
# Sin ella el agente NO se cae: corre con el motor determinista y lo dice en
# la interfaz. Es lo que permite demostrar sin red.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de síntesis y de lectura conversacional.
# Verificados contra este endpoint:
#   nvidia/nemotron-3.5-lightning-30b-a3b   (predeterminado; JSON limpio y rápido)
#   openai/gpt-oss-20b                      (secundario)
# Ojo: `nvidia/nemotron-3-super-120b-a12b` aparece al listar el catálogo pero
# devuelve 404 salvo que la cuenta tenga esa función habilitada.
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Solo para desarrollo: origen al que se le permite llamar a la API desde otro
# dominio. En producción el frontend y la API comparten dominio y esto se deja
# vacío, que es lo más cerrado.
CORS_ORIGEN=
